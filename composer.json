{
    "name": "fopost/laravel",
    "description": "Official Laravel SDK for the FoPost API. Schedule and publish to +30 social platforms from your code.",
    "keywords": ["fopost", "laravel", "social-media", "scheduling", "publishing", "api", "sdk"],
    "homepage": "https://fopost.com",
    "license": "MIT",
    "authors": [
        {
            "name": "FoPost",
            "homepage": "https://fopost.com"
        },
        {
            "name": "Porter Bridge, LLC",
            "homepage": "https://fopost.com"
        }
    ],
    "support": {
        "docs": "https://fopost.com/docs",
        "issues": "https://github.com/fopost/fopost-laravel/issues",
        "source": "https://github.com/fopost/fopost-laravel"
    },
    "require": {
        "php": ">=8.2",
        "fopost/sdk": "^0.1",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Fopost\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fopost\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fopost\\Laravel\\FopostServiceProvider"
            ],
            "aliases": {
                "Fopost": "Fopost\\Laravel\\Facades\\Fopost"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
